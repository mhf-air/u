/** title
this is `num--c` and `version`

```
a := 1
```

```
b
```
*/
/// a
f func() {
    sum u32 := (0,,)
        .map(|n u32|: u32 { n * n })
        .take-while(|n &u32|: bool { *n < 1000 })
        .filter(|n &u32|: bool { *n % 2 == 1 })
        .fold(0, |acc u32, n u32| { acc + n } )

    sum u32 := (0,,)
        .map(|n| n * n)
        .take-while(|n| *n < 1000)
        .filter(|n| *n % 2 == 1)
        .fold(0, |acc, n| acc + n)
}

vec macro {
    ( $( $x:expr ),* ) => {
        {
            let mut temp-vec = Vec::new();
            $(
                temp-vec.push($x);
            )*
            temp-vec
        }
    };
}

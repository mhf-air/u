identifier func() {
    - = "-"
    a = "a"

    c- = "c-"
    -c = "-c"
    -A = "-A"
    aa = "aa"
    Aa = "Aa"

    // the following two cases are forbidden
    // aA = "aA"
    // AA = "AA"
    // A--b = ""
    // A-1 = ""

    -- = "--"
    --- = "---"
    --r = "--r"
    --c = "--c"

    name--c = "name--c"

    Order = "Order"
    Order---r = "Order_"
    Order-item = "Order-item"
    Order-item--r = "Order_item"
    a-A--r = "a-A";

    order = "order"
    submit-order = "submit-order"
    mut- = "mut-"

    c-void = "c-void"
}

// use fn() for function type, not func
Point[T] type = fn(T, T): T
Point+[T Copy + Default] type = (T, T)
Point^[T Copy + Default] type = (T, T)
Point[N const usize] type Copy + Clone = [`i32; N`]
Point[T] type = (T, T) where { T Copy }
Point[T] type = fn(T) where { T Iterator }
Point['a 'b + 'c, 'd 'e] type = &'a i32
Point[T] type = abc..Abc..[T]
Point[T] type = std..boxed..Box[dyn std..ops..Fn-once(isize): isize]
Point[T] type = impl Iterator[Item = ops..Example[T]]
Point[T] type = impl Iterator[Item ops..Example[T]]
Point type = [S]..f
Point type = [S as Copy]..f

foo['a, 'b, T] func[async, unsafe](a i32, b i32) i32 where {
    T Iterator
    T..Item Copy
    String Partial-eq[T]
    T Iterator[Item Copy]
    fn(T) Iterator
    f Box[dyn Fn-mut(&mut T) + 'a]
    'a 'b
} {}

f func(
    a i32,
    b i32,
) {
    f(
        a,
        b,
    )
    vec_(
        a,
        b,
    )
}

f func(a fn(&mut App), b i32) {
    list.collect[Vec[-]]()

    id = 1
    a = &id
    a = &mut id
    a = &raw mut id
    a = &raw const id

    a = &&id
    a = &&mut id
    a = &&raw mut id
    a = &&raw const id

    // must have a ';' if the next stmt starts with some characters, including '&', "&&", etc.
    a;
    &raw const id
}

const-c-void[T] func(r &T) *const c-void {
    ret r as fn() as i32
    ret r as *const T as *const c-void
}

Person['a] struct where {
    T Clone
} {
    #[serde(rename = "lnum")]
    name+ &'a str
    age i32
    desc String
}
impl Person {
    no-s (&) func[no-s]() String {
        _ self.desc
    }
    has-s (&) func() String {
        _ s.desc
    }
}

impl fmt..Debug for Person['a] {
    fmt (&) func(f &mut fmt..Formatter['-]) fmt..Result {
        f.debug-struct("")
            .field(&s.name, "")
            .field(&s.age, "")
            .finish()
    }
}
impl !Clone for Person {}

